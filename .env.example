APP_NAME=Open Odds Intelligence
HOST=0.0.0.0
PORT=8765
DATABASE_PATH=./data/odds_history.sqlite3
ODDS_PROVIDER=therundown
# Choose "therundown" for the free 3-book feed, or "the_odds_api" for The Odds API.
THERUNDOWN_API_KEY=
THE_ODDS_API_KEY=
ODDS_REGIONS=us
# TheRundown Free: 20,000 data points/day, 200,000/month; default polling is hourly.
RUNDOWN_REFRESH_INTERVAL_SECONDS=3600
RUNDOWN_UTC_OFFSET_MINUTES=0
# Optional exact bookmaker keys (comma-separated); overrides ODDS_REGIONS when set.
# For wider US coverage, use ODDS_REGIONS=us,us2 instead (higher quota usage).
ODDS_BOOKMAKERS=
ODDS_MARKETS=h2h,spreads,totals
ODDS_FORMAT=american
ODDS_SPORTS=americanfootball_nfl,basketball_nba,icehockey_nhl,baseball_mlb,soccer_epl
ODDS_REFRESH_INTERVAL_SECONDS=0
DISCORD_WEBHOOK_URL=
ALERT_MIN_EV_PERCENT=3.0
ALERT_MIN_ARB_PERCENT=0.5

# TheRundown automatically refreshes hourly by default to conserve free-plan data points.
# Discord-enabled The Odds API deployments automatically refresh every 5 minutes by default.
DISCORD_ALERT_REFRESH_INTERVAL_SECONDS=300
