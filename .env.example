APP_NAME=Open Odds Intelligence
# Authentication mode: legacy_basic preserves the existing behavior. Do not select
# identity until the complete cutover gates in docs/basic-auth-transition.md pass.
AUTH_MODE=legacy_basic
# Optional legacy HTTP Basic authentication. Set BOTH values to enable protection.
# Use a long unique password; never commit real credentials to this file.
AUTH_USERNAME=
AUTH_PASSWORD=
# Retry only transient non-quota provider errors; 429 stops the refresh immediately.
PROVIDER_RETRY_ATTEMPTS=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.5
PROVIDER_RETRY_MAX_DELAY_SECONDS=5
DATABASE_PATH=./data/odds_history.sqlite3
# Optional per-league model fitted from earlier verified results; absent file uses broad priors.
SIMULATION_MODEL_PATH=./data/simulation_models.json
# Automatically collect final scores for archived TheRundown events without sportsbook prices.
# Disabled by default to protect data-point allowance; set true to enable TheRundown score-only collection.
SIMULATION_RESULTS_SYNC_ENABLED=false
SIMULATION_RESULTS_SYNC_INTERVAL_SECONDS=14400
SIMULATION_RESULTS_RETRY_SECONDS=14400
SIMULATION_RESULTS_LOOKBACK_DAYS=7
# Recheck recent final scores for timestamped provider corrections; 0 disables rechecks to conserve quota.
SIMULATION_RESULTS_RECHECK_DAYS=0
SIMULATION_RESULTS_MAX_GROUPS_PER_RUN=10
# Mark per-sport quotes stale after this many seconds (default six hours).
ODDS_DATA_STALE_AFTER_SECONDS=21600
ODDS_PROVIDER=therundown
# Optional comma-separated simultaneous providers; blank preserves ODDS_PROVIDER.
# Example: ODDS_PROVIDERS=therundown,the_odds_api,oddize,oddslink
ODDS_PROVIDERS=
# Legacy single-provider fallback; ODDS_PROVIDERS enables simultaneous providers.
THERUNDOWN_API_KEY=
# Optional additional free-tier keys; comma- or newline-separated, case-sensitive.
THERUNDOWN_API_KEYS=
THE_ODDS_API_KEY=
THE_ODDS_API_KEYS=
# Oddize Developer API is free: 1,500 credits/month, one key, no credit card.
ODDIZE_API_KEY=
ODDIZE_API_KEYS=
ODDIZE_PROPS_ENABLED=true
# Rotates one prop market type per supported sport per manual refresh (2 credits each).
ODDIZE_PROP_TYPES_PER_REFRESH=1
# Daily: 6 leagues x (1 odds + 2 props + 4 alternate-line credits) ~= 1,260/month.
ODDIZE_REFRESH_INTERVAL_SECONDS=86400
ODDIZE_ALTS_ENABLED=true
# Fetch alt spreads/totals for at most this many upcoming games per supported league.
ODDIZE_ALT_EVENTS_PER_REFRESH=1
# OddsLink Free: all 47 books across supported sports, 1,000 odds requests/month.
ODDSLINK_API_KEY=
# Optional additional keys; same-account keys share the same monthly allowance.
ODDSLINK_API_KEYS=
# Daily all-book refresh: about 270 requests/month for 9 sports.
ODDSLINK_REFRESH_INTERVAL_SECONDS=86400
# When OddsLink is not in ODDS_PROVIDERS, the standalone limit poller uses the key above.
# The daily default polls five leagues (~150 priced requests/month).
LIMITS_REFRESH_INTERVAL_SECONDS=86400
# The Odds API is manual by default; if enabled, its free-tier interval is clamped to at least daily.
ODDS_REFRESH_INTERVAL_SECONDS=0
# Optional comma-separated subset; defaults to ODDS_SPORTS.
LIMITS_SPORTS=
# Limit alerts are increases only by default; set true to alert decreases too.
LIMITS_ALERT_DECREASES=false
ODDS_REGIONS=us
# TheRundown Free: 20,000 data points/day, 200,000/month; default polling is every four hours.
RUNDOWN_REFRESH_INTERVAL_SECONDS=14400
RUNDOWN_UTC_OFFSET_MINUTES=0
# Optional exact bookmaker keys (comma-separated); overrides ODDS_REGIONS when set.
# For wider US coverage, use ODDS_REGIONS=us,us2 instead (higher quota usage).
ODDS_BOOKMAKERS=
ODDS_MARKETS=h2h,spreads,totals
ODDS_FORMAT=american
ODDS_SPORTS=americanfootball_nfl,americanfootball_ncaaf,basketball_nba,basketball_ncaab,icehockey_nhl,baseball_mlb,soccer_epl,tennis_atp,tennis_wta
DISCORD_WEBHOOK_URL=
ALERT_MIN_EV_PERCENT=5.0
ALERT_MIN_ARB_PERCENT=1.0

# TheRundown automatically refreshes every four hours by default to conserve free-plan data points.
# Discord-enabled The Odds API deployments automatically refresh every 5 minutes by default.
DISCORD_ALERT_REFRESH_INTERVAL_SECONDS=300
# At most three strongest alerts from the nearest upcoming event-date slate per check.
DISCORD_ALERT_MAX_PER_CYCLE=3

# Capture first positive-EV quote per exact selection for closing-line value.
CLV_MIN_EV_PERCENT=1.0
CLV_MAX_CLOSE_AGE_MINUTES=120

# Optional player props: disabled by default; only The Odds API supports this adapter.
PLAYER_PROPS_ENABLED=false
PLAYER_PROPS_SPORT=basketball_nba
PLAYER_PROPS_MARKETS=player_points,player_rebounds,player_assists
# Player props are polled no more often than every four hours; at most five events per poll.
PLAYER_PROPS_REFRESH_INTERVAL_SECONDS=14400
PLAYER_PROPS_MAX_EVENTS=5

# Keep CLV entries pending after kickoff while a final pregame snapshot may arrive.
CLV_CLOSE_GRACE_MINUTES=180

# Transactional email for subscriber verification and password recovery.
# Verify your sender domain and use a sending-only provider API key.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
