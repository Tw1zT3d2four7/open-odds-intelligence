# Copy to .env.staging and replace every placeholder in a private secret store.
# This file is for an isolated non-production deployment only.
AUTH_MODE=identity
ACCOUNTS_DATABASE_PATH=/app/data/accounts.sqlite3
DATABASE_PATH=/app/data/odds_history.sqlite3

# Generate independent keys; never reuse provider credentials or one key for another purpose.
MFA_ENCRYPTION_KEY=
RATE_LIMIT_HASH_KEY=
EMAIL_QUEUE_ENCRYPTION_KEY=
IDENTITY_BACKUP_ENCRYPTION_KEY=

# Configure only after a verified staging sender/domain is ready.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
PUBLIC_BASE_URL=https://replace-with-your-staging-hostname.example

# No real payments in staging until the dedicated Stripe test-mode acceptance is performed.
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENCRYPTION_KEY=
STRIPE_WEBHOOK_LIVEMODE=false
STRIPE_TEST_MODE_ACKNOWLEDGED=false
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CUSTOMER_PORTAL_ENABLED=false

# Keep external odds and alert delivery disabled until staging credentials and quotas are approved.
ODDS_PROVIDER=
ODDS_PROVIDERS=
THERUNDOWN_API_KEY=
THE_ODDS_API_KEY=
ODDIZE_API_KEY=
ODDSLINK_API_KEY=
DISCORD_WEBHOOK_URL=
ODDS_REFRESH_INTERVAL_SECONDS=0
RUNDOWN_REFRESH_INTERVAL_SECONDS=0
DISCORD_ALERT_REFRESH_INTERVAL_SECONDS=0
