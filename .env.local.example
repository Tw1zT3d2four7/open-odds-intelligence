# Copy to .env.local for the isolated localhost-only test instance.
APP_NAME=Open Odds Intelligence Local Test
AUTH_MODE=identity
AUTH_ENVIRONMENT=development
AUTH_IDENTITY_ENABLED=true
AUTH_REGISTRATION_ENABLED=true
AUTH_SUBSCRIBER_LOGIN_ENABLED=true
AUTH_EMAIL_VERIFICATION_REQUIRED=false
AUTH_EMAIL_TRANSPORT=disabled
AUTH_PASSWORD_RECOVERY_ENABLED=false
AUTH_ADMIN_MFA_REQUIRED=true
AUTH_SUBSCRIBER_MFA_REQUIRED=false
AUTH_RATE_LIMITING_ENABLED=false
AUTH_CSRF_REQUIRED=true
AUTH_SUBSCRIBER_SESSION_IDLE_SECONDS=86400
AUTH_ADMIN_SESSION_IDLE_SECONDS=14400
PUBLIC_BASE_URL=http://localhost:18765
ACCOUNTS_DATABASE_PATH=./data/local-accounts.sqlite3
DATABASE_PATH=./data/local-odds-history.sqlite3
# Generate these locally; do not reuse production keys.
MFA_ENCRYPTION_KEY=
RATE_LIMIT_HASH_KEY=
# Optional provider keys for local odds data only. Preserve case exactly.
THERUNDOWN_API_KEY=
THERUNDOWN_API_KEYS=
THE_ODDS_API_KEY=
THE_ODDS_API_KEYS=
ODDIZE_API_KEY=
ODDIZE_API_KEYS=
ODDSLINK_API_KEY=
ODDSLINK_API_KEYS=
DISCORD_WEBHOOK_URL=
# Billing and email remain inactive in this isolated test instance.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_QUEUE_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_LIVEMODE=false
STRIPE_TEST_MODE_ACKNOWLEDGED=false
STRIPE_WEBHOOK_ENCRYPTION_KEY=
STRIPE_PRICE_MONTHLY_ID=
STRIPE_PRICE_YEARLY_ID=
STRIPE_CHECKOUT_ENABLED=false
STRIPE_CUSTOMER_PORTAL_ENABLED=false
